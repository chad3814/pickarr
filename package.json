{
  "name": "pickarr",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint",
    "test-hygiene": "node --import tsx --conditions development scripts/check-test-hygiene.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsgo --noEmit -p scripts",
    "test:server": "node --import tsx --conditions development --test \"packages/*/test/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:web": "TSX_TSCONFIG_PATH=packages/web/tsconfig.json node --import tsx --import ./packages/web/test/setup.ts --conditions development --test \"packages/web/test/**/*.test.tsx\"",
    "test": "npm run test:server && npm run test:web",
    "corpus": "node --import tsx --conditions development scripts/parse-corpus.ts",
    "reclassify-artwork": "node --import tsx --conditions development scripts/reclassify-artwork.ts",
    "e2e": "npm run e2e -w @pickarr/e2e",
    "check": "npm run lint && npm run typecheck && npm run test-hygiene && npm run test",
    "build": "npm run build -w @pickarr/contract -w @pickarr/plugin-api -w @pickarr/plugin-scenes -w @pickarr/core -w @pickarr/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "latest",
    "esbuild": "^0.25.0",
    "oxlint": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
