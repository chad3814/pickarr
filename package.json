{
  "name": "pickarr",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,host -c cyan,magenta \"npm run dev -w @pickarr/web\" \"npm run dev:host\"",
    "dev:host": "PICKARR_DATABASE=./pickarr.dev.db PICKARR_PUBLIC_URL=http://localhost:5173 node --watch --env-file-if-exists=.env.local --import tsx --conditions development packages/host/src/bin.ts",
    "lint": "oxlint",
    "test-hygiene": "node --import tsx --conditions development scripts/check-test-hygiene.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsgo --noEmit -p scripts",
    "test:server": "node --import tsx --conditions development --test \"packages/*/test/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:web": "TSX_TSCONFIG_PATH=tsconfig.test-web.json node --import tsx --import ./packages/web/test/setup.ts --conditions development --test \"packages/*/test/**/*.test.tsx\"",
    "test": "npm run test:server && npm run test:web",
    "reclassify-artwork": "node --import tsx --conditions development scripts/reclassify-artwork.ts",
    "seed-feed": "node --import tsx --conditions development scripts/seed-feed.ts",
    "seed-client": "node --import tsx --conditions development scripts/seed-client.ts",
    "e2e": "npm run e2e -w @pickarr/e2e",
    "check": "npm run lint && npm run typecheck && npm run test-hygiene && npm run test",
    "build": "npm run build -w @pickarr/contract -w @pickarr/plugin-ui -w @pickarr/openmetadata -w @pickarr/plugin-tv -w @pickarr/plugin-movie -w @pickarr/plugin-xxx -w @pickarr/web -w @pickarr/host"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "latest",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "oxlint": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  }
}
