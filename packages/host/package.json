{
  "name": "@pickarr/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts src/bin.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node --import tsx --conditions development src/bin.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pickarr/contract": "*",
    "better-auth": "^1.7.3",
    "drizzle-orm": "1.0.0-rc.4",
    "fast-xml-parser": "^4.5.0",
    "image-size": "^2.0.2"
  }
}
