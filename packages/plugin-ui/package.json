    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@pickarr/contract": "*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
